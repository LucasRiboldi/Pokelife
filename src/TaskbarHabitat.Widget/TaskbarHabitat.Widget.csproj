<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deskband11Lib.WinUI" Version="1.5.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <ProjectReference Include="../TaskbarHabitat.Data/TaskbarHabitat.Data.csproj" />
    <Content Include="Assets/Sprites/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Habitats/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets/Habitats/*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
