<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <ProjectReference Include="../TaskbarHabitat.Data/TaskbarHabitat.Data.csproj" />
    <Content Include="Assets/Sprites/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Habitats/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Habitats/Viridian/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets/Habitats/Viridian/layout.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Habitats/ViridianAmpliada/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets/Habitats/*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- shortcut: unpackaged WinUI publish omits the app PRI (WindowsAppSDK#6720). Remove when the SDK publishes it. -->
  <Target Name="PublishWinUIResourceIndex" AfterTargets="Publish" Condition="'$(WindowsPackageType)' == 'None'">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
